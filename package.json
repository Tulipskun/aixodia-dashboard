{
  "name": "aixodia-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "cf:dev:worker": "wrangler dev --config wrangler.worker.toml",
    "cf:dev:pages": "wrangler pages dev ./dist --port 8788",
    "deploy:worker": "wrangler deploy --config wrangler.worker.toml",
    "deploy:pages": "npm run build && wrangler pages deploy ./dist --project-name aixodia-dashboard",
    "hash:password": "node scripts/hash-password.mjs",
    "secrets:worker": "node scripts/set-secrets.mjs worker",
    "secrets:pages": "node scripts/set-secrets.mjs pages",
    "cf:secret:worker": "wrangler secret put SESSION_SECRET --config wrangler.worker.toml",
    "cf:secret:pages": "wrangler pages secret put SESSION_SECRET --project-name aixodia-dashboard"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wrangler": "^4.158.0"
  }
}
