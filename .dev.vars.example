# Copy to .dev.vars and fill in real values. NEVER commit .dev.vars.
# These 5 values are secrets. Generate them on the remote machine:
#   SESSION_SECRET        : openssl rand -base64 32
#   AUTH_USERNAME         : choose a username
#   AUTH_PASSWORD_HASH    : npm run hash:password  (paste a password via stdin)
#   CF_ACCESS_CLIENT_ID   : /root/aixodia-mcp-access-client-id
#   CF_ACCESS_CLIENT_SECRET: /root/aixodia-mcp-access-client-secret
#
# The Cloudflare Access credentials are only used server-side when proxying to
# mcp.aixodia.dpdns.org — they are NEVER returned to the browser.
SESSION_SECRET=replace_with_openssl_rand_base64_32
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=pbkdf2$100000$replace_with_generated_hash
CF_ACCESS_CLIENT_ID=replace_with_access_client_id
CF_ACCESS_CLIENT_SECRET=replace_with_access_client_secret

# Non-secret overrides (optional; same defaults live in wrangler*.toml)
MCP_BASE_URL=https://mcp.aixodia.dpdns.org
SESSION_TTL_SEC=28800
SESSION_VERSION=1
