# Base URL of the AIxodia Engine. The SPA calls this directly (no Worker).
# Default (when unset): https://aixodia.dpdns.org  (Named Tunnel -> engine 127.0.0.1:8787)
#
# Production / tunnel:
# VITE_ENGINE_URL=https://aixodia.dpdns.org
#
# Local dev, direct to the engine (engine CORS must list http://localhost:5173):
# VITE_ENGINE_URL=http://127.0.0.1:8787
#
# Local dev through the Vite proxy (vite.config.ts strips the /engine prefix):
# VITE_ENGINE_URL=/engine
#
# On the engine side set:
#   ALLOWED_GITHUB_USERS=<comma-separated GitHub logins allowed to sign in>
#   ALLOWED_ORIGINS=https://dashboard.aixodia.dpdns.org,http://localhost:5173
