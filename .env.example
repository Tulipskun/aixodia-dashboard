# AIxodia Engine base URL. Default: https://engine.aixodia.dpdns.org
# The browser calls the Engine directly through the Named Tunnel.
#
# Production:
# VITE_ENGINE_URL=https://engine.aixodia.dpdns.org
#
# Local development, direct to the Engine (Engine CORS must allow localhost:5173):
# VITE_ENGINE_URL=http://127.0.0.1:8787
#
# Local development through the Vite proxy:
# VITE_ENGINE_URL=/engine
#
# Public GitHub OAuth App client ID. The application has a built-in default;
# set this only when using a different OAuth App. This value is public.
# VITE_GITHUB_CLIENT_ID=Ov23lieKSrKCRs5YKwdO
#
# Dashboard OAuth callback (configure this exact URL in the GitHub OAuth App):
# https://aixodia.dpdns.org
#
# Engine-only settings (do not add these to this file or any VITE_* variable):
# GITHUB_CLIENT_ID=Ov23lieKSrKCRs5YKwdO
# GITHUB_CLIENT_SECRET=<store only in the Engine environment or Workers KV>
# GITHUB_REDIRECT_URI=https://aixodia.dpdns.org
# ALLOWED_GITHUB_USERS=<comma-separated allowed GitHub logins>
# ALLOWED_ORIGINS=https://aixodia.dpdns.org,http://localhost:5173
#
# The Engine can alternatively read the OAuth client secret from Workers KV:
# AIXODIA_CONFIG/client/github_client_secret
